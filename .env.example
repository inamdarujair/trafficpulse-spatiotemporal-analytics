# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Cloud Database Connection String (Replace credentials with your own)
# Example format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database_name>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/mumbai_traffic?retryWrites=true&w=majority
